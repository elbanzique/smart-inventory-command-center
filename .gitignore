# Python
__pycache__/
*.pyc
.venv/
venv/
env/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# Pytest
.pytest_cache/

# OS
.DS_Store
Thumbs.db

# IDE
# .vscode/ is tracked deliberately — settings.json and launch.json give
# anyone opening this repo a working interpreter/pytest/debug setup out of
# the box (see README's "Opening in VS Code" section).
*.code-workspace

# Data - raw & processed data are regenerated by scripts, not committed
data/raw/*.csv
data/processed/*.csv
data/database/*.db
data/powerbi_export/*.csv

# LaTeX build artifacts - report.tex is the source, report.pdf is the
# tracked deliverable; everything else here is regenerated by `make`.
docs/report/*.aux
docs/report/*.log
docs/report/*.out
docs/report/*.toc
docs/report/*.lof
docs/report/*.lot

# Keep folder structure via .gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/database/.gitkeep
!data/powerbi_export/.gitkeep

# Power BI - working files can be large/binary; keep only final .pbix if desired
powerbi/*.pbix.bak

# Environment variables
.env

# Reports - figures are regenerated by src/analysis/generate_report.py
reports/figures/*.png
reports/dashboard.html
