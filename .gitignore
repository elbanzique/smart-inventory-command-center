# Python
__pycache__/
*.pyc
.venv/
venv/
env/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# Pytest
.pytest_cache/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
*.code-workspace

# Data - raw & processed data are regenerated by scripts, not committed
data/raw/*.csv
data/processed/*.csv
data/database/*.db

# Keep folder structure via .gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/database/.gitkeep

# Power BI - working files can be large/binary; keep only final .pbix if desired
powerbi/*.pbix.bak

# Environment variables
.env
