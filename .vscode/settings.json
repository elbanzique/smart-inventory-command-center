{
    // Points VS Code at the project's virtual environment. Created by the
    // "Setup" step in README.md — if you used a different name/location,
    // update this path (or just let VS Code prompt you to select it).
    "python.defaultInterpreterPath": "${workspaceFolder}/venv/bin/python",

    // Enables the Testing sidebar (flask icon) to discover and run the 36
    // tests under tests/ via pytest, instead of unittest.
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.pytestArgs": [
        "tests"
    ],

    // The project's modules import as `from src import config`, `from
    // src.data_generation.utils import ...`, etc. This tells Pylance
    // (VS Code's Python language server) to resolve those against the
    // project root, so you get working autocomplete/go-to-definition
    // instead of red squiggly "unresolved import" warnings.
    "python.analysis.extraPaths": [
        "${workspaceFolder}"
    ],

    // Keeps __pycache__/.pytest_cache out of the file explorer — these are
    // regenerated constantly and aren't meant to be edited or committed.
    "files.exclude": {
        "**/__pycache__": true,
        "**/.pytest_cache": true
    }
}
