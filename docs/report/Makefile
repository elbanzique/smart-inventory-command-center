# Compiles the final technical report to PDF.
#
# Prerequisites: a TeX distribution with pdflatex (texlive-latex-extra,
# texlive-fonts-recommended, texlive-latex-recommended cover everything used
# here). The three chart images under Chapter 6 (Python/Pandas Deep-Dive)
# come from reports/figures/, which is generated by the pipeline — run
#   python -m src.analysis.generate_report
# from the project root at least once before building this report.
#
# Diagram sources (docs/diagrams/*.puml) are pre-rendered to PNG and
# committed, so rebuilding the report itself does not require Java/PlantUML
# — only regenerating the diagrams from source does (see
# docs/diagrams/README.md).

.PHONY: all clean

all: report.pdf

report.pdf: report.tex
	pdflatex -interaction=nonstopmode report.tex
	pdflatex -interaction=nonstopmode report.tex
	pdflatex -interaction=nonstopmode report.tex

clean:
	rm -f *.aux *.log *.out *.toc *.lof *.lot
